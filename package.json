{
  "name": "dsh-session-rows",
  "version": "0.3.0",
  "type": "module",
  "description": "DEPRECATED: a shim over `system1-measure/rules`. The row contract moved to the measurement package; this name still resolves the same rules.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "npm run ci",
    "test": "node --test test/*.test.js",
    "coverage": "node --experimental-test-coverage --test --test-coverage-include='index.js' --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=75 test/*.test.js",
    "ci": "npm test && npm run coverage"
  },
  "files": [
    "index.js",
    "fixture/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlam1968/dsh-session-rows.git"
  },
  "homepage": "https://github.com/johnlam1968/dsh-session-rows#readme",
  "bugs": {
    "url": "https://github.com/johnlam1968/dsh-session-rows/issues"
  },
  "author": "John Lam <jwebster@gmail.com>",
  "keywords": [
    "session",
    "rows",
    "contract",
    "conformance",
    "fixture",
    "harness-free"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "system1-measure": "github:johnlam1968/system1-measure#v0.1.0"
  }
}
